# Supabase (projet gratuit) : Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_xxxx

# Serveur uniquement (jamais NEXT_PUBLIC_) : invitations d'utilisateurs et alertes par email
SUPABASE_SERVICE_ROLE_KEY=

# Adresse publique de l'application (QR codes, liens des emails)
APP_URL=http://localhost:3000

# Alertes d'échéance par email (Vercel Cron appelle /api/cron/alerts avec ce secret)
CRON_SECRET=une-longue-chaine-aleatoire-de-32-caracteres-minimum
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
MAIL_FROM="DIOMETRO <no-reply@votre-domaine.sn>"
